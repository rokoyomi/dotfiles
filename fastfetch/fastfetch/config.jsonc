{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/novelite.txt", // or a specific distro name, or "none" to disable
        "padding": {
            "top": 1,
            "right": 2
        }
    },
    "display": {
        "separator": " → "
    },
    "modules": [
        "title",
        "separator",
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        // "display",
        "de",
        "wm",
        "wmtheme",
        // "theme",
        // "icons",
        // "font",
        "terminal",
        "cpu",
        "gpu",
        "memory",
        "swap",
        // "disk",
        // "localip",
        // "battery",
        // "poweradapter",
        "locale",
        "break",
        "colors"
    ]
}
